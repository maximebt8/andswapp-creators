{
  "name": "andswapp-creators",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "dev:cf": "nuxt build && wrangler pages dev dist --port 4705",
    "db:local": "wrangler d1 execute andswapp-creators --local --file schema.sql",
    "deploy": "nuxt build && wrangler pages deploy dist --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "daisyui": "^5.0.0",
    "nuxt": "^4.3.1",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
